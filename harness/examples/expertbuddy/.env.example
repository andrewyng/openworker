# Local development: no Docker or Kubernetes. npm start reads .env.
INSPECTIONBUDDY_MODE=local
PORT=4336
DATA_DIR=.data
OPENAI_API_KEY=
# Exact model ID must support image input and be available to your account.
OW_MODEL=gpt-6-luna
# To change an immutable model/agent definition, use a new identity or data dir.
# OW_AGENT=inspectionbuddy-v1

# Workstation frontend for an existing edge app (no model key on workstation):
# INSPECTIONBUDDY_MODE=frontend
# EDGE_API_URL=https://inspection-api.example.com
# EDGE_APP_TOKEN_FILE=/absolute/private/app-token

# Edge app (provider key belongs to the service worker, not this process):
# INSPECTIONBUDDY_MODE=edge
# HOST=127.0.0.1
# OW_SERVICE_URL=https://agent-service.example.com
# OW_SERVICE_NAMESPACE=local
# OW_SERVICE_TOKEN_FILE=/absolute/private/operator-token
# EDGE_APP_TOKEN_FILE=/absolute/private/app-token
# OW_AGENT=inspectionbuddy@1
# NODE_EXTRA_CA_CERTS=/absolute/private/api-ca.crt
