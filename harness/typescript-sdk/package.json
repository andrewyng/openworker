{
  "name": "@openworkerai/harness-sdk",
  "version": "0.1.0-beta.2",
  "description": "Node.js client for the OpenWorker Rust harness over managed private stdio",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:coding-presets": "npm run build && node scripts/sync-coding-presets.mjs --check && node --test test/coding-presets.test.mjs",
    "test:team-placement": "npm run build && node --test test/team-placement.test.mjs",
    "test:coding-presets:integration": "npm run build && node --test --test-concurrency=1 test/coding-presets-live.test.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/config.test.mjs test/transport.test.mjs test/attempt-output.test.mjs",
    "test:stream-events": "npm run build && node --test --test-concurrency=1 test/stream-events.test.mjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/integration.test.mjs",
    "test:dynamic-agents": "npm run build && node --test --test-concurrency=1 test/dynamic-agents.test.mjs",
    "test:tool-free": "npm run build && node --test --test-concurrency=1 test/tool-free.test.mjs",
    "test:openrouter-streaming": "npm run build && node --test test/openrouter-streaming.test.mjs",
    "test:chat-usage": "npm run build && node --test --test-concurrency=1 test/chat-usage.test.mjs",
    "test:anthropic-caching": "npm run build && node --test --test-concurrency=1 test/anthropic-caching.test.mjs",
    "test:gemini-compat": "npm run build && node --test --test-concurrency=1 test/gemini-compat.test.mjs",
    "test:session-options": "npm run build && node --test --test-concurrency=1 test/session-options.test.mjs",
    "test:provider-auth": "npm run build && node --test test/provider-auth.test.mjs",
    "prepack": "npm run build",
    "test:service": "npm run build && node --test test/service.test.mjs",
    "test:team-types": "npm run build && node --test --test-concurrency=1 test/team-types.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewyng/openworker.git",
    "directory": "harness/typescript-sdk"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "private": true
}
