<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Playwright's Chromium renderer and GPU helpers execute V8/graphics JIT code.
     When OpenWorker re-signs those nested helpers with Hardened Runtime for
     notarization, this entitlement preserves the capability present on signed
     production Chromium-family helpers. Keep this narrower than the app/sidecar
     entitlements and apply it only to the Renderer and GPU helper bundles. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
