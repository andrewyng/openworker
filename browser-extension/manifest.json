{
  "manifest_version": 3,
  "name": "OpenWorker Browser Control",
  "description": "Share individual Chrome tabs with your local OpenWorker agent.",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Share this tab with OpenWorker",
    "default_popup": "popup.html"
  }
}
