---
import {desktopPreview,navigation} from '../lib/desktop-preview.mjs';
import '../styles/desktop-preview.css';
const {design}=Astro.props;
const guide=await desktopPreview();
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const sourceUrl=`${base}/examples/desktop.json`;
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="robots" content="noindex,nofollow"/>
 <title>{design==='apple'?'Studio':'Editorial'} — OpenWorker Desktop guide preview</title>
 <meta name="description" content="An alternative reading experience for the OpenWorker Desktop app guide."/>
</head>
<body class={design}>
 <a href="#article" class="skip-link">Skip to guide</a>
 <header class="masthead">
  <a class="brand" href={`${base}/`} aria-label="OpenWorker documentation"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" transform="rotate(90 12 12)" d="M12 1.8 13.35 9.66 20.83 6.9 14.7 12l6.13 5.1-7.48-2.76L12 22.2l-1.35-7.86-7.48 2.76L9.3 12 3.17 6.9l7.48 2.76L12 1.8Z"/></svg><span>OpenWorker</span><span class="brand-divider"></span><span class="brand-docs">Developer</span></a>
  <nav class="design-picker" aria-label="Compare design previews"><span>Preview</span><a href={`${base}/previews/desktop/apple/`} aria-current={design==='apple'?'page':undefined}>A · Studio</a><a href={`${base}/previews/desktop/notion/`} aria-current={design==='notion'?'page':undefined}>B · Editorial</a></nav>
  <a class="repo-link" href="https://github.com/andrewyng/openworker/tree/openworker-harness-sdk/harness">GitHub <span aria-hidden="true">↗</span></a>
 </header>
 <div class="docs-bar"><span>Documentation</span><a href={`${base}/`}>Harness SDK</a></div>
 <aside class="sidebar" aria-label="Documentation navigation">
  <div class="sidebar-title">Harness SDK</div>
  <label class="guide-search"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><input type="search" placeholder="Filter guides" aria-label="Filter documentation guides"/></label>
  <nav>{navigation.map(group=><details class="nav-group" open={group.open} data-initial-open={String(!!group.open)}><summary>{group.title}</summary><div>{group.links.map(([label,slug])=><a href={slug==='desktop'?'#article':`${base}/${slug?slug+'/':''}`} aria-current={slug==='desktop'?'page':undefined} data-guide-link>{label}</a>)}</div></details>)}</nav>
  <p class="no-guides" hidden>No matching guides.</p>
  <div class="sidebar-bottom"><a href={`${base}/`}>All documentation <span aria-hidden="true">↗</span></a></div>
 </aside>
 <main id="article">
  <section class="page-hero" aria-labelledby="guide-title">
   <div class="hero-inner">
    <div class="breadcrumb"><a href={`${base}/`}>Harness SDK</a><span aria-hidden="true">/</span><span>Desktop apps</span></div>
    <div class="page-symbol" aria-hidden="true"><svg viewBox="0 0 48 48"><rect x="6" y="8" width="36" height="26" rx="4"/><path d="M18 41h12M24 34v7"/></svg></div>
    <h1 id="guide-title">{guide.title}</h1>
    <div class="hero-description" set:html={guide.subtitle}/>
    <div class="hero-actions"><a class="primary-action" href="#build-with-your-coding-agent">Build with AI <span aria-hidden="true">↗</span></a><button type="button" class="secondary-action" data-example-source={sourceUrl}>View example source <span aria-hidden="true">↗</span></button></div>
    <span class="hero-motif" aria-hidden="true">{'{ }'}</span>
   </div>
  </section>
  <div class="reading-layout">
   <article class="guide-prose" set:html={guide.html}/>
   <aside class="contents" aria-label="On this page"><span>On this page</span><nav>{guide.headings.map(heading=><a href={`#${heading.slug}`} data-section-link>{heading.text}</a>)}</nav></aside>
  </div>
  <footer class="article-footer"><span>OpenWorker Harness SDK</span><a href={`${base}/server/`}>Next: Build a web app <span aria-hidden="true">→</span></a></footer>
 </main>
 <dialog id="example-source-drawer" aria-labelledby="example-source-title">
  <header class="source-header"><div><span class="source-label">EXAMPLE SOURCE</span><h2 id="example-source-title">Code Atlas</h2></div><button type="button" data-source-close aria-label="Close source code">×</button></header>
  <div class="source-body"><nav aria-label="Example files" data-source-files></nav><section class="source-view" aria-label="Selected source file"><div class="source-toolbar"><span data-source-path></span><button type="button" data-source-copy>Copy</button></div><pre tabindex="0"><code data-source-content></code></pre></section></div>
  <p class="source-status" role="status" data-source-status></p>
 </dialog>
 <script>
  import '../scripts/code-tabs';
  import '../scripts/source-explorer';
  import '../scripts/desktop-preview';
 </script>
</body>
</html>
