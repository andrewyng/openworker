{
  "name": "openworker-docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-content": "node scripts/prepare.mjs",
    "dev": "npm run prepare-content && astro dev",
    "build": "npm run prepare-content && astro build && pagefind --site dist --root-selector \"[data-pagefind-body]\"",
    "preview": "astro preview",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "astro": "^5.6.0",
    "yaml": "^2.4.0",
    "@astrojs/markdown-remark": "6.3.11",
    "@astrojs/sitemap": "3.7.3",
    "pagefind": "1.5.2"
  }
}
