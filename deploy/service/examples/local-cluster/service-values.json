{
  "image": "registry.example.com/openworker/service@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "secrets": {
    "model": "ow-service-model"
  },
  "worker": {
    "replicas": 1,
    "ownership": "manual",
    "maxReplicas": 2,
    "slots": 2,
    "drainSeconds": 30
  },
  "terminationGracePeriodSeconds": 90,
  "managementUI": {
    "enabled": true,
    "image": "registry.example.com/openworker/ui@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "publicOrigin": "https://localhost:8444",
    "serviceUrl": "https://ows-api.ow-service-m4-local.svc",
    "caSecret": "ow-service-tls",
    "caKey": "ca.crt",
    "tlsSecret": "ow-service-tls"
  },
  "config": {
    "service": {
      "id": "ows-local-example",
      "namespace": "local",
      "agent": "installed-tools",
      "legacy_compatibility": false
    },
    "database_env": "OW_PG_URL",
    "schema": "ow_service",
    "database_loopback_plaintext": false,
    "database_ca": "/run/service/pg-ca.crt",
    "state_root": "/state",
    "bundle": "/opt/openworker/bundle",
    "runner": "/opt/openworker/openworker",
    "model": "claude-sonnet-4-6",
    "scripted": false,
    "model_provider": "anthropic",
    "model_connections": [
      {
        "id": "primary",
        "provider": "anthropic",
        "identity": "local-primary",
        "key_env": "ANTHROPIC_API_KEY"
      }
    ],
    "api_token_file": "/bootstrap/admin-token",
    "actor": "deployment-admin",
    "openshell": {
      "identity": "ows-local-example",
      "endpoint": "https://ow-helm-gateway.ow-helm-shell.svc.cluster.local:8080",
      "tls_server_name": "ow-helm-gateway.ow-helm-shell.svc.cluster.local",
      "certificates": "/openshell",
      "workspace": "default",
      "image": "registry.example.com/openworker/runner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "observability": {
      "schema": "ow_observability",
      "retention_days": 14
    }
  }
}
